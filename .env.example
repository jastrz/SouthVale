# Database
POSTGRES_DB=townmanager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT
Jwt__Key=a-long-secret-key-at-least-32-characters

# LLM (optional)
LlmPlayer__ApiUrl=
LlmPlayer__ApiKey=
LlmPlayer__Model=
LlmPlayer__EnableThinking=true
LlmPlayer__Temperature=0.7
LlmPlayer__ReasoningEffort=medium
LlmPlayer__ThinkingTokens=16384
LlmPlayer__NonThinkingTokens=4096
LlmPlayer__TickIntervalCron=*/45 * * * *

# Client API URL. Empty = same-origin, nginx proxies /auth, /hubs, etc. to backend.
# App base path (build-time). Empty or / = app at domain root. /southvale/ = subpath deploy.
VITE_BASE_URL=
VITE_API_URL=

# Contact email shown in privacy notice
VITE_CONTACT_EMAIL=

# CORS
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=https://somedomain.com

# pgAdmin
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# Admin acc (optional — omit to skip admin user creation)
Admin__Password=change-this-password

# Backup (optional — defaults to @daily, keeps last 7 daily dumps, no weekly/monthly tier)
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=0
BACKUP_KEEP_MONTHS=0

# Barbarians
Barbarian__TargetPopulation=15
Barbarian__MaxTroopRatio=0.5
Barbarian__TickIntervalCron=*/30 * * * *

# Game settings
GameSettings__TravelSpeedMultiplier=1
GameSettings__ResourcesProductionMultiplier=1
GameSettings__UpkeepMultiplier=1
GameSettings__BuildSpeedMultiplier=1
GameSettings__TrainSpeedMultiplier=1

# Feature flags
Features__UseBarbarians=true
Features__UseLlmPlayers=false
